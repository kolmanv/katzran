# /etc/katzran/katzran.env (systemd format: comments on their own lines only)
# int8 or fp16 models (int8: half the memory, same speed on an iGPU); rerun install.sh after changing
VARIANT=int8
DEVICE=GPU
# languages to expect; a caller can narrow it per job (?languages=ru)
LANGUAGES=he,ru,en
# below this detection confidence, a part that may be Hebrew or another language runs on both models
LANGUAGE_SURE=0.8
# seconds without work before the models leave memory
IDLE_UNLOAD=300
MAX_MB=300
MAX_HOURS=3
